// Cloudflare Containers deployment for the skipwait.me API.
// Non-secret runtime vars below. Secrets (DATABASE_URL, JWT_SECRET,
// WORKOS_API_KEY, WORKOS_COOKIE_PASSWORD, ZEPTOMAIL_API_KEY, AI_PROVIDER_API_KEY)
// live in the Worker secret store (`wrangler secret put ...`) and are forwarded
// into the container by the SkipwaitApi class in src/worker.ts.
{
  "name": "skipwaitmanus",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "skipwait.me/api/*", "zone_name": "skipwait.me" }
  ],
  // Scheduled jobs: src/worker.ts scheduled() POSTs the container's
  // /api/internal/jobs/tick, signed from JWT_SECRET (shared/jobsTick.ts JOBS_CRON).
  "triggers": { "crons": ["0 * * * *"] },
  "containers": [
    {
      "class_name": "SkipwaitApi",
      "image": "./Dockerfile",
      "max_instances": 3,
      // "basic" = 1/4 vCPU, 1 GiB. The default "lite" (1/16 vCPU) starved parallel requests: 8 calls on one page took 1.3-2.9 s each. Founder approved this size only (Oct 16).
      "instance_type": "basic",
      "name": "skipwaitmanus-api",
      // Keep the API next to the production MySQL (West US 2). Default placement follows the first request, which put it ~265 ms from the DB.
      "constraints": { "regions": ["WNAM"] }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SkipwaitApi",
        "class_name": "SkipwaitApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SkipwaitApi"
      ]
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "API_RELEASE": "legacy",
    "SKIPWAIT_ADMIN_EMAIL": "ayodhya@skipwait.me",
    "ENABLE_ADMIN_BOOTSTRAP": "false",
    "ENABLE_ADMIN_SMOKE_FIXTURE": "true",
    "WORKOS_CLIENT_ID": "client_01M17TTFJ6784B1CN6MHAHB60Y",
    "WORKOS_REDIRECT_URI": "https://skipwait.me/api/auth/workos/callback",
    "WORKOS_POST_SIGNIN_PATH": "/",
    "ZEPTOMAIL_FROM_EMAIL": "noreply@skipwait.me",
    "ERROR_ALERT_FROM_EMAIL": "noreply@skipwait.me",
    "VITE_APP_ID": "skipwait",
    "AI_MODEL": "",
    "BILLING_ENV": "live",
    "CHARGEBEE_LIVE_ENABLED": "true",
    "CHARGEBEE_LIVE_DOMAIN": "skipwait.me",
    "CHARGEBEE_LIVE_SITE": "skipwait"
  },
  "observability": { "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true }, "traces": { "enabled": false } }

  ,
  "env": {
    "qa": {
      "name": "skipwait-qa",
      "workers_dev": true,
      "routes": [],
      "triggers": { "crons": [] },
      //basic (1 GiB): lite (256 MiB) VMs stopped at boot with zero logs - OOM signature; prod runs basic (founder-approved Oct 16)
      "containers": [{ "class_name": "SkipwaitApi", "image": "./Dockerfile.qa", "max_instances": 1, "instance_type": "basic", "name": "skipwait-qa-api" }],
      "durable_objects": { "bindings": [{ "name": "SkipwaitApi", "class_name": "SkipwaitApi" }] },
      "vars": {
        "NODE_ENV": "test",
        "QA_PREVIEW": "true",
        "API_RELEASE": "qa",
        "SKIPWAIT_ADMIN_EMAIL": "ayodhya@skipwait.me",
        "ENABLE_ADMIN_BOOTSTRAP": "false",
        "ENABLE_ADMIN_SMOKE_FIXTURE": "true",
        "BILLING_ENV": "test",
        "CHARGEBEE_LIVE_ENABLED": "false",
        // Boot blocker fix: validateBillingEnvironment() throws without these in
        // BILLING_ENV=test, which killed the container at boot with no logs.
        // Dummy values - live billing is disabled here; test-site calls would
        // just fail auth, no money path.
        "CHARGEBEE_SITE": "skipwait-test",
        "CHARGEBEE_API_KEY": "qa-preview-dummy",
        "CHARGEBEE_WEBHOOK_SECRET": "qa-preview-dummy",
        "COMPANY_RESPONSE_SIGNAL_ENABLED": "true",
        "SHARE_IMPACT_CARD_ENABLED": "true"
      }
    }
  }
}
