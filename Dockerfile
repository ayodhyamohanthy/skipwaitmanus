# skipwait.me API server (Cloudflare Containers compatible)
FROM node:22-slim AS build
WORKDIR /app
RUN npm install -g pnpm@10.34.7
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build
# commit-sha.txt is a gitignored build artifact generated by the GHA deploy-api
# workflow. Other builders (e.g. Cloudflare Workers Builds running
# `wrangler deploy` on main) never generate it, so guarantee it here instead of
# COPY-ing a file that may not exist on the daemon's context.
RUN if [ ! -f commit-sha.txt ]; then echo "unknown" > commit-sha.txt; fi

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/drizzle ./drizzle
COPY --from=build /app/commit-sha.txt ./commit-sha.txt
EXPOSE 3000
CMD ["node", "dist/index.js"]
