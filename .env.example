# skipwait.me — local development environment template
# Copy to .env and fill in values. Never commit .env.

# --- Application ---
VITE_APP_TITLE=skipwait.me
VITE_APP_ID=

# --- Server runtime ---
JWT_SECRET=replace-with-a-long-random-string
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
PORT=3000
# Trust CF-Connecting-IP for client IP resolution. Enable ONLY when the origin
# firewall accepts traffic exclusively from Cloudflare; otherwise IP-based rate
# limits can be spoofed. Leave blank (false) unless that invariant holds.
TRUST_CLOUDFLARE_CONNECTING_IP=

# --- Cloudflare deployment (credits-funded) ---
# R2 document storage: create a bucket + S3-auth API token in the CF dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skipwait-documents

# --- Transactional email (ZeptoMail primary; Resend fallback) ---
# ZeptoMail (Zoho): create a Mail Agent for skipwait.me, generate a Send API key,
# and verify the sending domain. Pay-per-credit, no monthly fee.
# Optional key for the work-email fingerprint (queue task 3). Work-email OTP
# codes, receipts and the verify aside have always stored only
# `h:<HMAC-SHA256 of the address>`; unset, that key derives from JWT_SECRET (a
# separate `work-email:` derivation, never shared with the Slack webhook key).
# Set it to rotate the fingerprint independently. Rotating JWT_SECRET or setting
# this value invalidates only codes and receipts in flight, each alive 10 minutes.
WORK_EMAIL_HMAC_KEY=
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=noreply@skipwait.me
ZEPTOMAIL_FROM_NAME=SkipWait
# Seeker agents (Skippy step 5, D-141): draft-only agent API + grant screen. Off unless true.
SKIPPIE_AGENT_ENABLED=
# Reviewer sign-in (Razorpay review and QA). Off unless true. Password hashes come from hashReviewerPassword.
REVIEWER_LOGIN_ENABLED=
# Seeker Skippy (ask-only chat, D-136..D-142 step 2). Off unless true; when on, only these account ids see it.
SKIPPIE_SEEKER_ENABLED=
SKIPPIE_SEEKER_USER_IDS=
# Admin Skippie (read-only assistant). Off unless true. SENTRY_READ_TOKEN is optional.
SKIPPIE_ADMIN_ENABLED=
SENTRY_READ_TOKEN=
REVIEWER_ALLOW_ADMIN=
REVIEWER_SEEKER_PASSWORD_HASH=
REVIEWER_REFERRER_PASSWORD_HASH=
REVIEWER_EMPLOYER_PASSWORD_HASH=
REVIEWER_ADMIN_PASSWORD_HASH=

# --- WorkOS AuthKit (production auth) ---
# Create a WorkOS project, enable AuthKit, set the redirect URI to
# https://skipwait.me/api/auth/workos/callback, then fill these in.
# WorkOS keys are production-only; without them the local dev-auth plane is active.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# 32+ character random string used to encrypt the AuthKit session cookie
WORKOS_COOKIE_PASSWORD=
# Webhook endpoint secret (Dashboard → Webhooks → endpoint details). Verifies
# POST /api/webhooks/workos deliveries (user.deleted suspends the local
# account). Absent = 503 fail-closed so WorkOS retries instead of dropping.
WORKOS_WEBHOOK_SECRET=
WORKOS_REDIRECT_URI=https://skipwait.me/api/auth/workos/callback
WORKOS_POST_SIGNIN_PATH=/
# Public origin used to build one-time links (password-reset emails). Falls
# back to WORKOS_REDIRECT_URI's origin when unset; set explicitly per env.
PUBLIC_BASE_URL=https://skipwait.me
# Client build flag: routes startLogin() to the AuthKit flow
VITE_WORKOS_ENABLED=
# WorkOS AuthKit client id (public): read by the client SDK provider.
# Production value is pinned in .github/workflows/deploy-pages.yml.
VITE_WORKOS_CLIENT_ID=
# Exact commit baked into the web bundle for release verification.
# Set automatically by CI (VITE_GIT_COMMIT_SHA); leave blank locally.
VITE_GIT_COMMIT_SHA=

# --- Resend email ---
RESEND_API_KEY=
ERROR_ALERT_FROM_EMAIL=noreply@skipwait.me

# --- Sentry error reporting (optional; everything is a no-op when blank) ---
# Server (API container) DSN + browser DSN (baked into the client bundle).
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Test gates (opt-in external credential checks) ---
RUN_EXTERNAL_CREDENTIAL_TESTS=false
RUN_LIVE_ADMIN_ALERT_TEST=false

# --- Real-MySQL concurrency harness (test infra in server/mysqlTest/) ---
# Plain `pnpm test` skips these specs. The `mysql-concurrency` CI job starts a
# throwaway MySQL 8 service, rebuilds its schema from drizzle/schema.ts, and
# runs them there. Locally, against any scratch MySQL 8 database named
# skipwait_test* whose user holds privileges on that database:
#   MYSQL_TEST_URL=... node scripts/prepare-mysql-test-schema.mjs
#   MYSQL_TEST_URL=... MYSQL_CONCURRENCY_TESTS=1 \
#     pnpm vitest run --no-file-parallelism server/mysqlTest
# Keep --no-file-parallelism: each spec file rebuilds the sandbox, so parallel
# files would truncate each other's fixtures.
# The database name must start with skipwait_test: the harness truncates every
# table it finds, so it refuses any other name and refuses a target that
# DATABASE_URL already points at.
MYSQL_TEST_URL=
MYSQL_CONCURRENCY_TESTS=false
# Race probes assert invariants production does not have yet (audit B1/B2), so
# they run only in the CI job's non-blocking step. Set true to see them red.
MYSQL_RACE_PROBE=false

# --- Managed runtime (Manus hosting only; leave blank locally) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Payments: Razorpay (INR) + PayPal (USD) + Chargebee (hosted checkout & subscriptions) ---
# BILLING_ENV selects the Chargebee credential set process-wide: test uses
# CHARGEBEE_SITE/API_KEY/WEBHOOK_SECRET, live uses the CHARGEBEE_LIVE_* set.
# Production runs live; never set live locally.
BILLING_ENV=test
# WARNING: routes activate purely on env presence. Placeholder/dummy keys flip
# the endpoints below from 503 "not configured" to active, but any real
# checkout WILL fail against the provider API (and Chargebee checkout URLs
# 404 against a dummy site). Replace with real keys before enabling payments.
#
# Razorpay — INR token orders via POST /api/payments/razorpay/order.
# Active when BOTH RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are set.
# Dashboard → API Keys; test keys look like rzp_test_*, live like rzp_live_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook — POST /api/payments/razorpay/webhook verifies the
# x-razorpay-signature HMAC of the raw body against this secret. Unset = 503.
# Dashboard → Webhooks; production value needs `wrangler secret put`.
RAZORPAY_WEBHOOK_SECRET=
#
# PayPal — USD token orders via POST /api/payments/paypal/order.
# Active when BOTH PAYPAL_CLIENT_ID and PAYPAL_SECRET are set.
# PAYPAL_ENV selects the API base: sandbox|live (defaults to live when unset).
# developer.paypal.com → Live/Classic API app.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=live
# PayPal webhook — POST /api/payments/paypal/webhook. With client credentials
# AND this webhook id set, deliveries are verified via PayPal's
# verify-webhook-signature API; with the id unset they are only logged as
# requires_review (never credited). Production value needs `wrangler secret put`.
PAYPAL_WEBHOOK_ID=
#
# Chargebee — hosted checkout, subscriptions, and webhook fulfillment
# (/api/chargebee/*). Active when CHARGEBEE_API_KEY is set; the test site is
# CHARGEBEE_SITE ?? "skipwait-test". The webhook route
# (POST /api/chargebee/webhook) requires CHARGEBEE_WEBHOOK_SECRET.
CHARGEBEE_SITE=skipwait-test
CHARGEBEE_API_KEY=
CHARGEBEE_WEBHOOK_SECRET=
#
# Chargebee live site — used ONLY when CHARGEBEE_LIVE_ENABLED=true AND the
# request host matches CHARGEBEE_LIVE_DOMAIN (e.g. skipwait.me); other hosts
# keep using the test credentials above. Live site defaults to
# CHARGEBEE_LIVE_SITE ?? "skipwait". All five live vars are required together.
CHARGEBEE_LIVE_ENABLED=
CHARGEBEE_LIVE_SITE=
CHARGEBEE_LIVE_DOMAIN=
CHARGEBEE_LIVE_API_KEY=
CHARGEBEE_LIVE_WEBHOOK_SECRET=

# --- Administration ---
# The only address (this exact email, lowercased) that may sign in via
# /api/auth/workos/admin; also the recipient of error alerts.
SKIPWAIT_ADMIN_EMAIL=ayodhya@skipwait.me
# One-time admin bootstrap (first admin claim). Keep "false" except during the
# initial bootstrap window; the admin smoke fixture requires it plus the
# secret below, otherwise those routes 404.
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_SMOKE_SECRET=
# Admin smoke-test fixture (synthetic sessions for QA). "true" only in
# non-production verification; the fixture 404s when this is not "true".
ENABLE_ADMIN_SMOKE_FIXTURE=

# --- Runtime ---
# Set automatically in production deploys; leave blank locally.
NODE_ENV=

# --- AI features (model-agnostic, OpenAI-compatible) ---
# Any provider exposing POST {base}/chat/completions works: Together, Groq,
# Fireworks, DeepSeek, Qwen/DashScope, Mistral, OpenRouter, vLLM, Ollama...
# Swapping models = change these three lines. No code changes.
# Leave blank to use the managed-runtime model (when present) or static fallbacks.
# Example: https://api.groq.com/openai/v1 (or Together, DeepSeek, Qwen, OpenRouter, self-hosted vLLM...)
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=

# --- Analytics (optional) ---
# Umami analytics: injected only when both are set at build time.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
# Microsoft Clarity session replay (optional; client is a no-op when blank).
# Create a project at clarity.microsoft.com → Settings → Overview for the ID.
# Single-use link routes are never tracked (see client/src/lib/clarity.ts).
VITE_CLARITY_PROJECT_ID=

# Promo bonus-credit grants on first payment. Off until the issue #35 rebuild; only "true" enables.
PROMO_GRANTS_ENABLED=false
# Server: level-scaled ask cost, L1=1 credit ... L10=10 (D-110/D-132).
# Off everywhere until pricing go-live (owner's enable word + QA + payment reliability).
ASK_LEVEL_COST=false
# Client: pre-send ask-cost banner + one-tap top-up on the compose screen.
VITE_ASK_LEVEL_COST=false

# Billing switches (docs/DECISIONS.md D-007). Each is a display/sales gate only;
# money and credits still come only from a provider-confirmed webhook.
# INDIA_GST_REGISTERED: SkipWait is an Indian sole proprietorship (Udyam MSME) and
# is NOT GST-registered, so no GST is charged and INR prices read "India price".
# Set to true only once a GSTIN exists AND Chargebee tax mode + GST invoices are on.
INDIA_GST_REGISTERED=false
# USD_RECURRING_CONFIRMED: USD passes stay one-time until PayPal reference
# transactions or a card route are confirmed. Only "true" offers USD auto-extend.
USD_RECURRING_CONFIRMED=false
# HUMAN_REVIEWERS_STAFFED: human written reviews and live sessions sell only once
# reviewers are staffed and contracted. Only "true" makes them purchasable.
HUMAN_REVIEWERS_STAFFED=false
# EMPLOYER_SPONSORSHIP_ENABLED: the sponsor route (paid, labeled "Featured
# listing" on /wall — never priority over employee posts, D-040). Unlike the
# switches above this one defaults to ON, because the surface already delivers
# what it sells. Set to "false" to pause paid placement: the route answers 503
# and charges nothing.
EMPLOYER_SPONSORSHIP_ENABLED=true

# FREE_CREDITS_REQUIRE_CARD_VALIDATION: a seeker's free monthly credits unlock
# only after a card validated by the provider (D-079, owner Oct 19 2026). The
# check is Chargebee's card verification on its hosted page (a unit-currency
# authorization it voids automatically); SkipWait stores only the outcome.
# Default off: only "true" gates the grants. Enable in production only on the
# owner's yes after Chargebee-test-site QA.
FREE_CREDITS_REQUIRE_CARD_VALIDATION=false

# Read-only credential for GET /api/admin/billing/ledger (QA daily reconciliation).
# Sent as the x-billing-ledger-token header; opens that one endpoint only. Min 32 chars; set as a Worker secret.
BILLING_LEDGER_READ_TOKEN=

# Work-email re-verification (queue task 6). PR 1 is a dry-run job only; this flag is reserved for the
# enforcement PR and does nothing yet. Leave unset (OFF).
# REVERIFY_ENFORCE=

# Employee-shared openings: posting caps and expiry (optional; defaults 3, 10, 30)
OPPORTUNITY_MAX_OPEN_PER_USER=
OPPORTUNITY_MAX_PER_USER_PER_DAY=
OPPORTUNITY_HIRING_NOW_TTL_DAYS=

# D-104 company responsiveness signal (both off until QA verifies; set both to "true" to enable)
COMPANY_RESPONSE_SIGNAL_ENABLED=
VITE_COMPANY_RESPONSE_SIGNAL=

# Free company aggregate dashboard (off until QA)
COMPANY_CLAIM_ENABLED=false
VITE_COMPANY_CLAIM=false

# D-095 one-tap Pay sign-in (off until QA verifies)
VITE_ONE_TAP_PAY_SIGNIN=

# D-101 admin unmatched work-email domains list (off until QA verifies)
UNMATCHED_DOMAINS_ENABLED=

# Referrer impact card (slice C, flag off; server twin SHARE_IMPACT_CARD_ENABLED)
VITE_SHARE_IMPACT_CARD=false
SHARE_IMPACT_CARD_ENABLED=false
# Seeker win card (off until QA verifies; client build flag, no server twin)
VITE_SHARE_WIN_CARD=

# Goal-UI surfaces (D-134): comma-separated surface ids to force on locally
# and in QA builds ("all" for every id). Production releases surfaces from
# RELEASED in client/src/lib/goalSurfaces.ts; deploy never passes this.
VITE_GOAL_SURFACES=
# Client: swap the Plans page for the D-132 plan-family page. OFF until QA
# payment-path green + owner enable word.
VITE_PLAN_FAMILY_V2=false
# D-115/D-128: the Open Door / Fast Track / Insider plan family (shared/planFamily.ts).
# Off everywhere until pricing go-live (owner's one-word "A" + QA + payment reliability).
PLAN_FAMILY_V2=false

