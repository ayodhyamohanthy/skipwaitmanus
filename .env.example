# skipwait.me — local development environment template
# Copy to .env and fill in values. Never commit .env.

# --- Application ---
VITE_APP_TITLE=skipwait.me
VITE_APP_ID=

# --- Server runtime ---
JWT_SECRET=replace-with-a-long-random-string
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
PORT=3000

# --- Clerk authentication ---
CLERK_SECRET_KEY=
# Client (Vite-exposed): also set VITE_CLERK_PUBLISHABLE_KEY in your shell or .env.local
VITE_CLERK_PUBLISHABLE_KEY=

# --- Chargebee payments (test site first) ---
CHARGEBEE_SITE=skipwait-test
CHARGEBEE_API_KEY=
CHARGEBEE_WEBHOOK_SECRET=
# Live keys only when enabling the live site
CHARGEBEE_LIVE_API_KEY=

# --- Cloudflare deployment (credits-funded) ---
# R2 document storage: create a bucket + S3-auth API token in the CF dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skipwait-documents

# --- Transactional email (ZeptoMail primary; Resend fallback) ---
# ZeptoMail (Zoho): create a Mail Agent for skipwait.me, generate a Send API key,
# and verify the sending domain. Pay-per-credit, no monthly fee.
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=noreply@updates.skipwait.me

# --- WorkOS AuthKit (alternative production auth; replaces Clerk) ---
# Create a WorkOS project, enable AuthKit, set the redirect URI to
# https://skipwait.me/api/auth/workos/callback, then fill these in.
# Active only when CLERK_SECRET_KEY is NOT set.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# 32+ character random string used to encrypt the AuthKit session cookie
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=https://skipwait.me/api/auth/workos/callback
WORKOS_POST_SIGNIN_PATH=/
# Client build flag: routes startLogin() to the AuthKit flow
VITE_WORKOS_ENABLED=

# --- Resend email ---
RESEND_API_KEY=
ERROR_ALERT_FROM_EMAIL=noreply@updates.skipwait.me

# --- Test gates (opt-in external credential checks) ---
RUN_EXTERNAL_CREDENTIAL_TESTS=false
RUN_LIVE_ADMIN_ALERT_TEST=false

# --- Managed runtime (Manus hosting only; leave blank locally) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
